# Copy to `.env` (root) and fill in real values, then run: supabase stop && supabase start
# The Supabase CLI reads this for the env(...) refs in supabase/config.toml
# ([edge_runtime.secrets]) and injects them into the local edge functions.
#
# Without this, the AI functions fall back to generic, non-personalized output:
#   - plan-month, reflect, personalize, review-opportunity,
#     signal-summary, callout-expand, daily-mission, task-suggestion

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
